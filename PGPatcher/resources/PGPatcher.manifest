<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Merged by mt.exe into the manifest embedded in PGPatcher.exe (listed as a source in CMakeLists.txt).

  Declares the process DPI aware, so that on a monitor with a scale factor above 100% Windows renders the UI at the
  monitor's native resolution instead of stretching a 96 DPI bitmap of it, which is what makes it blurry. The dialogs
  scale their pixel sizes with wxWindow::FromDIP() so that the UI keeps the same on-screen size.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Windows 10 1607 and later: per-monitor v2 (each monitor at its own DPI), otherwise system DPI aware -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, system</dpiAwareness>
      <!-- Windows 7 and 8: system DPI aware -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
</assembly>
